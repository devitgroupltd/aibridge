node_modules/
dist/
*.log

# aibridge's own runtime state, if ever run from inside this checkout
.aibridge-state/

# per-session git worktrees, nested here so VS Code's Git extension auto-discovers them
# (see .vscode/settings.json) - each has its own .git file, never committed
.worktrees/

# secrets - bot tokens live in %APPDATA%\aibridge\.env / ~/.config/aibridge/.env, never here
.env
.env.*

# scripts/telegram-automation's persisted Chromium profile is a live logged-in Telegram session -
# a credential, never committed - plus the screenshots/status files login.js polls on disk
scripts/telegram-automation/profile/
scripts/telegram-automation/*.png
scripts/telegram-automation/status.txt
